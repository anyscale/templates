{
  "model": {
    "type": "ensemble",
    "model_configs": [
      {"type": "graph_convolutional", "in_features": 45, "out_features": 12, "hidden_features": 96, "dropout": 0.1, "layer_type": "torch_geometric.nn.LEConv", "layers_count": 7, "molecule_features": 17, "is_residual": 1, "norm_layer": "kmol.model.layers.BatchNorm"},
      {"type": "graph_convolutional", "in_features": 45, "out_features": 12, "hidden_features": 96, "dropout": 0.1, "layer_type": "torch_geometric.nn.LEConv", "layers_count": 7, "molecule_features": 17, "is_residual": 1, "norm_layer": "kmol.model.layers.BatchNorm"},
      {"type": "graph_convolutional", "in_features": 45, "out_features": 12, "hidden_features": 96, "dropout": 0.1, "layer_type": "torch_geometric.nn.LEConv", "layers_count": 7, "molecule_features": 17, "is_residual": 1, "norm_layer": "kmol.model.layers.BatchNorm"},
      {"type": "graph_convolutional", "in_features": 45, "out_features": 12, "hidden_features": 96, "dropout": 0.1, "layer_type": "torch_geometric.nn.LEConv", "layers_count": 7, "molecule_features": 17, "is_residual": 1, "norm_layer": "kmol.model.layers.BatchNorm"},
      {"type": "graph_convolutional", "in_features": 45, "out_features": 12, "hidden_features": 96, "dropout": 0.1, "layer_type": "torch_geometric.nn.LEConv", "layers_count": 7, "molecule_features": 17, "is_residual": 1, "norm_layer": "kmol.model.layers.BatchNorm"}
    ]
  },

  "checkpoint_path": [
    "checkpoints/model_0.pt",
    "checkpoints/model_1.pt",
    "checkpoints/model_2.pt",
    "checkpoints/model_3.pt",
    "checkpoints/model_4.pt"
  ],

  "loader": {
    "type": "csv",
    "input_path": "data/datasets/tox21.csv",
    "input_column_names": ["smiles"],
    "target_column_names": ["NR-AR", "NR-AR-LBD", "NR-AhR", "NR-Aromatase", "NR-ER", "NR-ER-LBD", "NR-PPAR-gamma", "SR-ARE", "SR-ATAD5", "SR-HSE", "SR-MMP", "SR-p53"]
  },

  "featurizers": [
    {"type": "graph", "inputs": ["smiles"], "outputs": ["graph"], "descriptor_calculator": {"type": "rdkit"}, "rewrite": false}
  ],

  "transformers": [],

  "collater": {"type": "general"},
  "preprocessor": {"type": "cache"},

  "splitter": {"type": "descriptor", "descriptor": "MolWt", "splits": {"train": 0.8, "test": 0.2}, "seed": 42, "bins_count": 10},

  "criterion": {"type": "kmol.model.criterions.MaskedLoss", "loss": {"type": "torch.nn.BCEWithLogitsLoss"}},
  "optimizer": {"type": "torch.optim.AdamW", "lr": 0.01, "weight_decay": 0.00056},
  "scheduler": {"type": "torch.optim.lr_scheduler.OneCycleLR", "max_lr": 0.01, "epochs": 200, "pct_start": 0.3, "div_factor": 25, "final_div_factor": 1000},

  "output_path": "/tmp/kmol_serve_logs/",
  "threshold": 0.5,
  "batch_size": 64,
  "use_cuda": true,
  "enabled_gpus": [0]
}
