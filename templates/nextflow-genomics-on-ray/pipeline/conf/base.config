/*
 * Resource labels and retry policy.
 *
 * The label names and their values are nf-core's, from `nf-core/conf/base.config`,
 * unchanged. That is the point: a reader who knows `process_medium` already knows
 * what this pipeline asks for, and an nf-core pipeline dropped onto this cluster
 * behaves the same way.
 *
 * Two things here do real work on Ray.
 *
 * `errorStrategy` is nf-core's exact predicate. The executor maps Ray's failure
 * modes onto exit codes inside this band (see nf_ray/errors.py), so a preempted
 * node or a memory-monitor kill arrives as a retryable status rather than as an
 * opaque "failed to get exit status". Nothing here had to change to get that --
 * which is the claim the template makes, tested rather than asserted.
 *
 * `task.attempt` scaling turns that into a real recovery. Ray's memory monitor
 * killing a worker maps to 137, the same code the kernel's OOM killer produces,
 * so the retry comes back asking for twice the memory. On an autoscaling cluster
 * that can mean a *larger instance type*, not just a longer wait.
 *
 * The ceiling is not free-floating. A request no node can satisfy pends forever
 * on Ray rather than failing, so `resourceLimits` is bounded by what the largest
 * worker in configs/nextflow-genomics-on-ray/{aws,gce}.yaml can *schedule*, and
 * conf/ray.config declares that same ceiling to the executor. Those three files
 * are one decision, and tests/nextflow-genomics-on-ray/test_config_agreement.py
 * fails when they drift.
 *
 * Schedulable, not installed. Ray 2.58.0 advertises a node's `memory` resource
 * as 70% of the memory free when the raylet starts, the other 30% going to the
 * object store (ray/_private/resource_and_label_spec.py and utils.py,
 * DEFAULT_OBJECT_STORE_MEMORY_PROPORTION = 0.3). So the 128 GiB r6i.4xlarge /
 * n2-highmem-16 worker schedules roughly 0.7 x (128 GiB less the OS and the
 * container) -- about 85 GiB, derived from that code and not yet measured on a
 * cluster. 80 GB is the ceiling below it. The earlier 64 GB on a 64 GiB
 * m5.4xlarge could never be met: that node schedules about 42 GiB, and
 * process_high (BWAMEM2_INDEX, BWAMEM2_MEM) would have pended forever.
 */

process {
    // The ceiling, applied by Nextflow to every request below. Replaces nf-core's
    // hand-written `check_max()` helper, which the strict parser rejects outright
    // -- config files may not declare functions. `resourceLimits` does the same
    // clamping natively and in one place.
    //
    // Bounded by what the largest worker the compute configs can start will
    // schedule (see above). Raising it without raising the instance type in
    // configs/nextflow-genomics-on-ray/{aws,gce}.yaml produces a task that pends
    // forever on Ray rather than failing -- so conf/ray.config declares the same
    // ceiling to the executor, which rejects such a request at submit time.
    // Those three files are one decision; test_config_agreement.py asserts it.
    resourceLimits = [ cpus: 16, memory: 80.GB, time: 24.h ]

    cpus   = { 1    * task.attempt }
    memory = { 6.GB * task.attempt }
    time   = { 4.h  * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    withLabel:process_single {
        cpus   = 1
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel:process_low {
        cpus   = { 2     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:process_high {
        cpus   = { 12    * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }
    withLabel:process_long {
        time   = { 20.h  * task.attempt }
    }
    withLabel:process_high_memory {
        // nf-core ships this at 200 GB. It is left at nf-core's value on purpose:
        // `resourceLimits` clamps it to the cluster's 80 GB, which is exactly the
        // behaviour an unmodified nf-core pipeline should get here rather than a
        // task that pends forever.
        memory = { 200.GB * task.attempt }
    }

    // Not an nf-core label. The GPU leg: one accelerator, and a modest CPU/memory
    // request so the task is not also waiting on a big node. `nvidia-l4` is
    // spelled the same on both clouds -- AWS g6 and GCP g2 are both L4 -- so the
    // request is portable, which `nvidia-tesla-t4` would not have been.
    //
    // Its own ceiling, because a GPU task can only land on the GPU group, and that
    // is a smaller node than the CPU ceiling above describes: 8 vCPU / 32 GiB
    // (g6.2xlarge, g2-standard-8-nvidia-l4-1), which by the same 70% rule
    // schedules about 20 GiB. Without this the retry's 32 GB would pass the
    // cluster-wide 80 GB and pend forever.
    withLabel:process_gpu {
        cpus           = { 4     * task.attempt }
        memory         = { 16.GB * task.attempt }
        time           = { 4.h   * task.attempt }
        accelerator    = [ request: 1, type: 'nvidia-l4' ]
        resourceLimits = [ cpus: 8, memory: 18.GB, time: 24.h ]
    }

    withLabel:error_ignore { errorStrategy = 'ignore' }
    withLabel:error_retry  { errorStrategy = 'retry'; maxRetries = 2 }
}
