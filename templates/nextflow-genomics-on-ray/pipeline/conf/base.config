/*
 * nf-core's resource labels and retry predicate, unchanged. nf_ray maps Ray
 * failures (OOM, lost node) onto exit codes inside the retry band.
 */

process {
    // Must be schedulable on the largest worker in the compute configs: Ray offers
    // ~70% of node memory to tasks, and a request no node can satisfy pends forever.
    resourceLimits = [ cpus: 16, memory: 80.GB, time: 24.h ]

    cpus   = { 1    * task.attempt }
    memory = { 6.GB * task.attempt }
    time   = { 4.h  * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    withLabel:process_single {
        cpus   = 1
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel:process_low {
        cpus   = { 2     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:process_high {
        cpus   = { 12    * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }
    withLabel:process_long {
        time   = { 20.h  * task.attempt }
    }
    withLabel:process_high_memory {
        // Left at nf-core's 200 GB; resourceLimits clamps it.
        memory = { 200.GB * task.attempt }
    }

    // Not an nf-core label. Its own ceiling, since a GPU task can only land on the
    // smaller GPU worker (8 vCPU / 32 GiB, ~20 GiB schedulable).
    withLabel:process_gpu {
        cpus           = { 4     * task.attempt }
        memory         = { 16.GB * task.attempt }
        time           = { 4.h   * task.attempt }
        accelerator    = [ request: 1, type: 'nvidia-l4' ]
        resourceLimits = [ cpus: 8, memory: 18.GB, time: 24.h ]
    }

    withLabel:error_ignore { errorStrategy = 'ignore' }
    withLabel:error_retry  { errorStrategy = 'retry'; maxRetries = 2 }
}
