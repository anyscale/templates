/*
 * Resource labels and retry policy.
 *
 * The label names and values are nf-core's, from `nf-core/conf/base.config`,
 * unchanged, so `process_medium` asks for what it asks for on any nf-core
 * pipeline.
 *
 * Two things here matter on Ray.
 *
 * `errorStrategy` is nf-core's predicate, unchanged. The executor maps Ray's
 * failure modes onto exit codes inside this band (see nf_ray/errors.py), so a
 * lost node or a memory-monitor kill arrives as a retryable status instead of
 * Nextflow's "failed to get exit status". test_nf_ray.py checks every mapped
 * code against the same predicate.
 *
 * `task.attempt` scaling makes the retry bigger. Ray's memory monitor killing a
 * task maps to 137, the kernel OOM killer's code, so the retry asks for twice
 * the memory, up to the ceiling below. The compute configs have one CPU worker
 * type, so here that means a larger share of the same node, capped at 80 GB.
 *
 * The ceiling is tied to the compute configs. A request no node can satisfy
 * pends forever on Ray, so `resourceLimits` is bounded by what the largest
 * worker in configs/nextflow-genomics-on-ray/{aws,gce}.yaml can *schedule*, and
 * conf/ray.config declares that same ceiling to the executor. Those three files
 * are one decision, and tests/nextflow-genomics-on-ray/test_config_agreement.py
 * fails when they drift.
 *
 * Schedulable, which is less than installed. Ray 2.58.0 advertises a node's
 * `memory` resource as 70% of the memory free when the raylet starts, the other
 * 30% going to the object store (ray/_private/resource_and_label_spec.py and
 * utils.py, DEFAULT_OBJECT_STORE_MEMORY_PROPORTION = 0.3). So the 128 GiB
 * r6i.4xlarge / n2-highmem-16 worker schedules roughly 0.7 x (128 GiB less the
 * OS and the container), about 85 GiB. That is derived from the code; on AWS the
 * worker placed the 72 GB process_high tasks in every 2026-09-25 prod run. 80 GB
 * is the ceiling below it. A 64 GiB m5.4xlarge schedules about 42 GiB, where
 * process_high (BWAMEM2_INDEX, BWAMEM2_MEM) would pend forever.
 */

process {
    // The ceiling, applied by Nextflow to every request below. Replaces nf-core's
    // hand-written `check_max()` helper, which the strict parser rejects (config
    // files may not declare functions); `resourceLimits` does the same clamping
    // natively, in one place.
    //
    // Bounded by what the largest worker the compute configs can start will
    // schedule (see above). Raising it without raising the instance type in
    // configs/nextflow-genomics-on-ray/{aws,gce}.yaml gives a task that pends
    // forever on Ray, so conf/ray.config declares the same ceiling to the
    // executor, which rejects such a request at submit time.
    // test_config_agreement.py checks the three files agree.
    resourceLimits = [ cpus: 16, memory: 80.GB, time: 24.h ]

    cpus   = { 1    * task.attempt }
    memory = { 6.GB * task.attempt }
    time   = { 4.h  * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    withLabel:process_single {
        cpus   = 1
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel:process_low {
        cpus   = { 2     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:process_high {
        cpus   = { 12    * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }
    withLabel:process_long {
        time   = { 20.h  * task.attempt }
    }
    withLabel:process_high_memory {
        // nf-core ships this at 200 GB, and it is left there: `resourceLimits`
        // clamps it to the cluster's 80 GB, which is what an nf-core pipeline's
        // request should get here instead of a task that pends forever.
        memory = { 200.GB * task.attempt }
    }

    // Not an nf-core label. The GPU leg: one accelerator, and a modest CPU and
    // memory request so the task does not also wait for a big node. `nvidia-l4`
    // is the same on both clouds (AWS g6 and GCP g2 are both L4), so the request
    // is portable.
    //
    // Its own ceiling, because a GPU task can only land on the GPU group, which is
    // a smaller node than the CPU ceiling above describes: 8 vCPU / 32 GiB
    // (g6.2xlarge, g2-standard-8-nvidia-l4-1), which by the same 70% rule
    // schedules about 20 GiB. Without it, the retry's 32 GB would pass the
    // cluster-wide 80 GB and pend forever.
    withLabel:process_gpu {
        cpus           = { 4     * task.attempt }
        memory         = { 16.GB * task.attempt }
        time           = { 4.h   * task.attempt }
        accelerator    = [ request: 1, type: 'nvidia-l4' ]
        resourceLimits = [ cpus: 8, memory: 18.GB, time: 24.h ]
    }

    withLabel:error_ignore { errorStrategy = 'ignore' }
    withLabel:error_retry  { errorStrategy = 'retry'; maxRetries = 2 }
}
