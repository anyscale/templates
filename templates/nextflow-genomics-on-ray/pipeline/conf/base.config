/*
 * Resource labels and retry policy.
 *
 * The label names and their values are nf-core's, from `nf-core/conf/base.config`,
 * unchanged. That is the point: a reader who knows `process_medium` already knows
 * what this pipeline asks for, and an nf-core pipeline dropped onto this cluster
 * behaves the same way.
 *
 * Two things here do real work on Ray.
 *
 * `errorStrategy` is nf-core's exact predicate. The executor maps Ray's failure
 * modes onto exit codes inside this band (see nf_ray/errors.py), so a preempted
 * node or a memory-monitor kill arrives as a retryable status rather than as an
 * opaque "failed to get exit status". Nothing here had to change to get that --
 * which is the claim the template makes, tested rather than asserted.
 *
 * `task.attempt` scaling turns that into a real recovery. Ray's memory monitor
 * killing a worker maps to 137, the same code the kernel's OOM killer produces,
 * so the retry comes back asking for twice the memory. On an autoscaling cluster
 * that can mean a *larger instance type*, not just a longer wait.
 *
 * The ceiling is not free-floating. A request no node can satisfy pends forever
 * on Ray rather than failing, so `check_max` is bounded by the largest worker in
 * configs/nextflow-genomics-on-ray/{aws,gce}.yaml, and conf/ray.config declares
 * that same ceiling to the executor. Those three files are one decision.
 */

process {
    // The ceiling, applied by Nextflow to every request below. Replaces nf-core's
    // hand-written `check_max()` helper, which the strict parser rejects outright
    // -- config files may not declare functions. `resourceLimits` does the same
    // clamping natively and in one place.
    //
    // Bounded by the largest worker the compute configs can start. Raising it
    // without raising the instance type in
    // configs/nextflow-genomics-on-ray/{aws,gce}.yaml produces a task that pends
    // forever on Ray rather than failing -- so conf/ray.config declares the same
    // ceiling to the executor, which rejects such a request at submit time.
    // Those three files are one decision; tests/ asserts they agree.
    resourceLimits = [ cpus: 16, memory: 64.GB, time: 24.h ]

    cpus   = { 1    * task.attempt }
    memory = { 6.GB * task.attempt }
    time   = { 4.h  * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    withLabel:process_single {
        cpus   = 1
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel:process_low {
        cpus   = { 2     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:process_high {
        cpus   = { 12    * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }
    withLabel:process_long {
        time   = { 20.h  * task.attempt }
    }
    withLabel:process_high_memory {
        // nf-core ships this at 200 GB. It is left at nf-core's value on purpose:
        // `resourceLimits` clamps it to the cluster's 64 GB, which is exactly the
        // behaviour an unmodified nf-core pipeline should get here rather than a
        // task that pends forever.
        memory = { 200.GB * task.attempt }
    }

    // Not an nf-core label. The GPU leg: one accelerator, and a modest CPU/memory
    // request so the task is not also waiting on a big node. `nvidia-l4` is
    // spelled the same on both clouds -- AWS g6 and GCP g2 are both L4 -- so the
    // request is portable, which `nvidia-tesla-t4` would not have been.
    withLabel:process_gpu {
        cpus        = { 4     * task.attempt }
        memory      = { 16.GB * task.attempt }
        time        = { 4.h   * task.attempt }
        accelerator = [ request: 1, type: 'nvidia-l4' ]
    }

    withLabel:error_ignore { errorStrategy = 'ignore' }
    withLabel:error_retry  { errorStrategy = 'retry'; maxRetries = 2 }
}
