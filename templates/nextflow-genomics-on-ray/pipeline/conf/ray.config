// -profile ray: everything Ray-specific, so moving from HPC to Ray is a profile.

plugins {
    // The version is required: without it Nextflow asks the registry, which has no
    // nf-ray, before looking in $NXF_PLUGINS_DIR.
    id 'nf-ray@0.1.0'
}

process {
    executor = 'ray'

    // Node-local NVMe: many small-file metadata ops are slow over NFS. Costs a copy
    // in and out; set `scratch false` where that dominates.
    scratch = '/mnt/local_storage'
}

// Must be at the same path on every node; a grid executor stages inputs by path.
workDir = '/mnt/cluster_storage/nf-work'

executor {
    // Only has to exceed the widest point of the DAG; Ray decides what runs.
    queueSize = 400
    submitRateLimit = '50/1sec'
    queueStatInterval = '5 sec'
    // .exitcode is read over NFS, where a new file can take a moment to appear.
    exitReadTimeout = '5 min'
    killBatchSize = 100
}

ray {
    // Declared, not discovered: ray.nodes() cannot see a GPU group at min_nodes 0.
    // Memory is what Ray will schedule on the largest worker, not its installed RAM.
    maxNodeCpus     = 16
    maxNodeMemoryGb = 80
    maxNodeGpus     = 1

    // For GPU requests that name no model (`accelerator 1`, `nvidia.com/gpu`).
    defaultAccelerator = 'nvidia-l4'

    // 'ignore' runs an unmapped ext.image in the cluster's image instead of failing.
    imageFallback = 'error'

    // 'SPREAD' distributes tasks over the nodes that are up.
    schedulingStrategy = 'DEFAULT'
}
