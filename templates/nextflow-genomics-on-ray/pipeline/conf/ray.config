/*
 * -profile ray
 *
 * Everything Ray-specific, in one file, so moving a pipeline from an HPC
 * cluster to Ray is a profile rather than a rewrite. Nothing in main.nf, the
 * modules or base.config refers to this file.
 */

plugins {
    // Declared here rather than in nextflow.config so that only a `ray` run has
    // to resolve it. The image installs it into $NXF_PLUGINS_DIR, so Nextflow
    // finds it offline: a cluster with no route to the plugin registry still
    // works, and no run pays for a download.
    //
    // The version is required. Without one, Nextflow asks the plugin registry
    // for the newest nf-ray before it looks on disk, and nf-ray is not in the
    // registry, so the run stops there. With it, the copy in
    // $NXF_PLUGINS_DIR/nf-ray-0.1.0 is used as is. Keep it in step with
    // nf-ray-plugin/build.gradle.
    id 'nf-ray@0.1.0'
}

process {
    // The executor from the nf-ray plugin. Every process directive keeps its
    // usual meaning; the executor translates cpus/memory/accelerator into a Ray
    // resource request. See nf_ray/resources.py for the table.
    executor = 'ray'

    // Run each task against node-local NVMe and copy results back, instead of
    // working directly in the shared work directory. A task creates, stats and
    // links many small files, and that metadata traffic is slow over NFS from
    // many nodes at once.
    //
    // The cost is I/O: inputs are copied in and outputs copied back, so a
    // process handling large BAMs pays twice to save the metadata round trips.
    // The trade has not been measured per stage; set `scratch false` on a process
    // where the copy dominates.
    scratch = '/mnt/local_storage'
}

// The work directory must be visible from every node at the same absolute path:
// Nextflow stages inputs by path, and a grid executor has no other way to move
// them. `nf-ray doctor` and the daemon both warn when it is not, because the
// failure appears only once the cluster has a second node, which on an
// autoscaling cluster can be minutes into a run that looked fine.
workDir = '/mnt/cluster_storage/nf-work'

executor {
    // How many tasks Nextflow keeps in flight. Ray decides what runs; this only
    // has to exceed the widest point of the DAG (144 HaplotypeCaller tasks at
    // `full`) so that Nextflow is never the bottleneck.
    queueSize = 400

    // One `nf-ray submit` process per task. The client is stdlib-only and talks
    // to a long-lived daemon over a unix socket precisely so this is cheap, but
    // there is no reason to spawn them faster than this.
    submitRateLimit = '50/1sec'

    // How often `nf-ray status` is called. One call returns the whole queue.
    queueStatInterval = '5 sec'

    // How long to wait for `.exitcode` after a task leaves the queue. Generous
    // because it is read over NFS, where a file just written on one node can take
    // a moment to appear on another.
    exitReadTimeout = '5 min'

    // Ids per `nf-ray kill` invocation.
    killBatchSize = 100
}

ray {
    // The largest request this cluster can grow to satisfy, from
    // configs/nextflow-genomics-on-ray/{aws,gce}.yaml. Declared rather than
    // discovered, because `ray.nodes()` only sees nodes that are already up: on a
    // cluster whose GPU group sits at min_nodes 0, an observed ceiling would
    // reject a request the autoscaler could satisfy by starting a node.
    //
    // Memory is what Ray will *schedule*, which is less than the instance has:
    // 80 GB on a 128 GiB worker, because Ray 2.58.0 advertises about 70% of free
    // memory as `memory` (conf/base.config has the arithmetic). Declaring the
    // instance's 128 would let through a request that then pends forever.
    //
    // These must track the compute config and `resourceLimits` in
    // conf/base.config; test_config_agreement.py fails when they drift.
    maxNodeCpus     = 16
    maxNodeMemoryGb = 80
    maxNodeGpus     = 1

    // GPU processes that name no model get this one: a bare `accelerator 1`, or
    // the Kubernetes-style `nvidia.com/gpu`, names none, so without this a GPU
    // task would be placed on whatever accelerator the cluster happened to have.
    defaultAccelerator = 'nvidia-l4'

    // Refuse an ext.image with no entry in imageMap rather than silently running
    // the task in the cluster's image. A process that runs against different
    // software than it declared produces results nobody can reproduce.
    imageFallback = 'error'

    // Ray's default placement, which favours nodes that already have work and
    // then less-loaded ones. SPREAD distributes tasks over the nodes that are up,
    // to demonstrate placement or for a stage bound by a node's network rather
    // than its cores.
    schedulingStrategy = 'DEFAULT'
}
