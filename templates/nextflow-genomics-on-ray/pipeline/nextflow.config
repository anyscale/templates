/*
 * Configuration for the GIAB trio germline pipeline and the smoke pipeline.
 *
 * Laid out the way an nf-core pipeline's is: `conf/base.config` carries the
 * resource labels, `conf/ray.config` carries everything Ray-specific, and the
 * `ray` profile is the only thing added to run on a Ray cluster.
 */

manifest {
    name            = 'nextflow-genomics-on-ray'
    author          = 'Anyscale'
    description     = 'GIAB trio germline short-variant calling on an autoscaling Ray cluster'
    version         = '0.1.0'
    mainScript      = 'main.nf'
    // The floor the plugin was compiled against. The template's image pins an
    // exact version; this is what an outside pipeline needs at minimum.
    nextflowVersion = '>=25.10.0'
}

// The nf-ray plugin is declared in conf/ray.config, not here. Declared at top
// level, every invocation would resolve it, including `-profile local`, which
// exists so the pipeline can be run and debugged on a machine with no Ray and no
// plugin installed.

params {
    // Scale knob, matching the env var the notebook and tests.sh set. Three
    // sizes of the same cohort with the same processes, tools and resource
    // requests; the region, interval count and GPU shard count differ, so a
    // green CI run at `quick` exercises the code path a reader gets at `standard`.
    scale        = System.getenv('NF_DEMO_SCALE') ?: 'standard'

    // sample,fastq_1,fastq_2[,truth_vcf,truth_bed]. The truth columns are per
    // sample on purpose (GIAB publishes one truth set per genome); a row without
    // them is called but not scored. bin/make_samplesheet.py writes this file
    // from a staged MANIFEST.json.
    samplesheet  = null
    outdir       = 'results'
    reference    = null
    known_sites  = null

    // These three are null on purpose. main.nf reads them as
    // `params.X ?: preset.X`, so a non-null default here would shadow the scale
    // preset in every case and `--scale quick` would silently keep the standard
    // interval count -- the CI run would then be doing three times the calling
    // work it was sized for. Set them explicitly to override a preset.
    region          = null
    intervals       = null
    annotate_shards = null

    // GPU annotation leg.
    annotate     = true

    publish_mode = 'copy'
}

// Resource labels, and the retry policy that makes Ray's failure modes legible.
includeConfig 'conf/base.config'

profiles {
    ray    { includeConfig 'conf/ray.config' }
    local  { process.executor = 'local' }
    conda  {
        // For a pipeline whose processes declare biocontainers. There is no
        // container runtime inside a Ray worker, so Nextflow builds each process
        // a conda environment instead. With the cache on shared storage, each is
        // built once per cluster rather than once per node per process.
        conda.enabled  = true
        conda.cacheDir = '/mnt/cluster_storage/conda'
        conda.useMicromamba = true
    }
    test   { params.scale = 'quick' }
}

// Reports. The notebook's Gantt chart joins `trace` to the executor's placement
// record on each task's work directory, so the trace is required here.
// `native_id` in its fields is the Ray task id `nf-ray submit` returns.
//
// Fixed filenames, not timestamped ones: the strict parser rejects a `def ts =
// ...` variable in a config file, and a timestamped name would make every reader
// glob for "the newest trace file", which can pick the wrong one. `overwrite =
// true` handles re-runs, and the notebook reads one known path.
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,submit,start,complete,duration,realtime,%cpu,peak_rss,workdir'
}
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html";      overwrite = true }
