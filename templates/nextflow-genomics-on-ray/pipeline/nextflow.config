manifest {
    name            = 'nextflow-genomics-on-ray'
    author          = 'Anyscale'
    description     = 'GIAB trio germline short-variant calling on an autoscaling Ray cluster'
    version         = '0.1.0'
    mainScript      = 'main.nf'
    nextflowVersion = '>=25.10.0'
}

// The nf-ray plugin is declared in conf/ray.config, so `-profile local` needs no plugin.

params {
    scale        = System.getenv('NF_DEMO_SCALE') ?: 'standard'

    // sample,fastq_1,fastq_2[,truth_vcf,truth_bed]; rows without truth are called, not scored.
    samplesheet  = null
    outdir       = 'results'
    reference    = null
    known_sites  = null

    // Null so the scale preset applies; main.nf reads `params.X ?: preset.X`.
    region       = null
    intervals    = null

    // The GPU arm: per-sample calls scored by NVScoreVariants on an L4.
    cnn          = true
    // Comma-separated VCFs (each with .tbi) for FilterVariantTranches. Required with --cnn.
    tranche_resources = null

    publish_mode = 'copy'
}

includeConfig 'conf/base.config'

profiles {
    ray    { includeConfig 'conf/ray.config' }
    local  { process.executor = 'local' }
    conda  {
        // No container runtime inside a Ray worker; a shared cache builds each env once.
        conda.enabled  = true
        conda.cacheDir = '/mnt/cluster_storage/conda'
        conda.useMicromamba = true
    }
    test   { params.scale = 'quick' }
}

// The notebook joins the trace to the executor's placement records, so it is required.
// Fixed names: the strict parser rejects a timestamp variable in config.
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,submit,start,complete,duration,realtime,%cpu,peak_rss,workdir'
}
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html";      overwrite = true }
