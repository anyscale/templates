/*
 * Configuration for the GIAB trio germline pipeline and the smoke pipeline.
 *
 * Structured the way an nf-core pipeline is, because the point of this template
 * is that your pipeline does not have to change: `conf/base.config` carries the
 * resource labels, `conf/ray.config` carries everything Ray-specific, and the
 * `ray` profile is the only thing you add to run on a Ray cluster.
 */

manifest {
    name            = 'nextflow-genomics-on-ray'
    author          = 'Anyscale'
    description     = 'GIAB trio germline short-variant calling on an autoscaling Ray cluster'
    version         = '0.1.0'
    mainScript      = 'main.nf'
    // The floor the plugin was compiled against. The template's image pins an
    // exact version; this is what an outside pipeline needs at minimum.
    nextflowVersion = '>=25.10.0'
}

// NOTE: the nf-ray plugin is declared in conf/ray.config, not here. Declaring it
// at top level would make every invocation resolve it -- including `-profile
// local`, which exists precisely so the pipeline can be run and debugged on a
// machine that has no Ray and no plugin installed.

params {
    // Scale knob, matching the env var the notebook and tests.sh set. Three
    // sizes of the same cohort: same tools, same DAG, same resource requests,
    // only the number of bases differs -- so a green CI run at `quick` exercises
    // the code path a reader gets at `standard`.
    scale        = System.getenv('NF_DEMO_SCALE') ?: 'standard'

    samplesheet  = null
    outdir       = 'results'
    reference    = null
    truth_vcf    = null
    truth_bed    = null
    known_sites  = null

    // These three are null on purpose. main.nf reads them as
    // `params.X ?: preset.X`, so a non-null default here would shadow the scale
    // preset in every case and `--scale quick` would silently keep the standard
    // interval count -- the CI run would then be doing three times the calling
    // work it was sized for. Set them explicitly to override a preset.
    region          = null
    intervals       = null
    annotate_shards = null

    // Second caller. On by default: one truth set scored against two callers is
    // a far more useful readout than either alone.
    deepvariant  = true

    // GPU annotation leg.
    annotate     = true

    publish_mode = 'copy'
}

// Resource labels, and the retry policy that makes Ray's failure modes legible.
includeConfig 'conf/base.config'

profiles {
    ray    { includeConfig 'conf/ray.config' }
    local  { process.executor = 'local' }
    conda  {
        // The escape hatch for a pipeline whose processes declare biocontainers.
        // There is no container runtime inside a Ray worker to nest into, so
        // Nextflow builds each process a conda environment instead. Point the
        // cache at shared storage and it is built once per cluster rather than
        // once per node per process.
        conda.enabled  = true
        conda.cacheDir = '/mnt/cluster_storage/conda'
        conda.useMicromamba = true
    }
    test   { params.scale = 'quick' }
}

// Reports. `trace` is not optional decoration here -- the notebook's Gantt chart
// is built by joining it to the executor's placement record on `native_id`, which
// is the Ray task id this executor returns from `nf-ray submit`.
//
// Fixed filenames, not timestamped ones. Two reasons, and the second is the real
// one: the strict parser rejects a `def ts = ...` variable in a config file, and
// -- more importantly -- a timestamped name forces every reader to glob for "the
// newest trace file", which is precisely the bug the sibling WDL template shipped
// (a recursive glob that picked up a nested sub-workflow's output because it had
// a newer mtime). `overwrite = true` handles re-runs; one known path is what the
// notebook and the tests both read.
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    overwrite = true
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,submit,start,complete,duration,realtime,%cpu,peak_rss,workdir'
}
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html";      overwrite = true }
